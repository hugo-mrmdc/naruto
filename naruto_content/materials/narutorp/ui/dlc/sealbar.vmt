UnlitGeneric {
    "$basetexture" "vgui/gradient-d"
    "$detail" "narutorp/noise/waves"
    "$detailscale" "1"
    "$detailblendmode" "8"
    "$vertexalpha" "1"
    "$vertexcolor" "1"
    "$nocull" "1"
    "Proxies" {
        "TextureScroll"
		{
			"texturescrollvar" "$detailtexturetransform"
			"texturescrollrate" 1
			"texturescrollangle" 90
		}
    }
}