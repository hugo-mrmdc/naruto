UnlitGeneric {
    "$basetexture" "narutorp/ui/loading"
    "$vertexalpha" "1"
    "$vertexcolor" "1"
    "Proxies" {
        "AnimatedTexture" {
            "animatedTextureVar" "$basetexture"
            "animatedTextureFrameNumVar" "$frame"
            "animatedTextureFrameRate" "16"
        }
    }
}