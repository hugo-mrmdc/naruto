VertexLitGeneric{
    "$basetexture" "narutorp/effects/electric/sparks"
    "$vertexalpha" "1"
    "$halflambert" "1"
    "$nocull" "1"
    "$vertexcolor" "1"
    "$color2" "[.5 1.2  2]"
    "Proxies" {
        "AnimatedTexture" {
            "animatedTextureVar" "$basetexture"
            "animatedTextureFrameNumVar" "$frame"
            "animatedTextureFrameRate" "15"
        }
    }
}