"VertexLitGeneric"
{
	"$surfaceprop" "default"
	"$basetexture" "narutorp/effects/byakugan/chakra_shield"
	"$translucent" "1"
	$EmissiveBlendEnabled 		1						// Enable EmissiveBlend. Like $selfillum 1	
	$EmissiveBlendStrength 		.8 						// how strong the entire glow effect is.
	$EmissiveBlendTexture 		"narutorp/effects/test/alpha"		// this is the glowing texture.vtf
	$EmissiveBlendBaseTexture 	"narutorp/effects/test/noise"		// This is the glowing texture's mask, like $selfillummask.  SHOULD BE VTF i8 FORMAT, NOT DXT5!!!
	$EmissiveBlendFlowTexture 	"narutorp/effects/byakugan/chakra_shield"	// EmmisiveBlend can "flow" or move. This here is the flowmap used, just like water.
	$EmissiveBlendTint 			" [ .1 1 .1 ] "			// RGB glow intensity. Leave at 1 1 1. This can be used to change how strong each color should glow. So instead of using a darker red color, you may use [.5 1 1] to have red glow half as strong.
	$EmissiveBlendScrollVector 	" [ .4 .15 ] " 
	$seamless_detail 1
	$seamless_scale 0.0078125

}