UnlitGeneric{
    "$basetexture" "narutorp/effects/fireball_trail"
    "$vertexalpha" "1"
    "$vertexcolor" "1"
    "Proxies" {
        "TextureScroll"{
            "textureScrollVar" "$basetexturetransform"
            "textureScrollRate" "1.5"
            "textureScrollAngle" "90"
        }
    }
}