UnlitGeneric {
    "$basetexture" "narutorp/effects/chakra/fire_anim"
    "$detail" "narutorp/effects/chakra/smoke"
    "$detailscale" "2"
    "$detailblendmode" "8"
    "$vertexalpha" "1"
    "$vertexcolor" "1"
    "$nocull" "1"
    "Proxies" {
        "AnimatedTexture" {
            "animatedTextureVar" "$basetexture"
            "animatedTextureFrameNumVar" "$frame"
            "animatedTextureFrameRate" "15"
        }
        "TextureScroll"
		{
			"texturescrollvar" "$detailtexturetransform"
			"texturescrollrate" 2
			"texturescrollangle" 60
		}
    }
}