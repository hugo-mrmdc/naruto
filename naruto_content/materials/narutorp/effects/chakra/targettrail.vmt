"UnlitGeneric" {
	"$baseTexture" "narutorp/effects/chakra/chakratrail"
	"$detail" "narutorp/effects/chinoike/vladimir_base_e_bloodball_stings"
    "$detailscale" "2"
    "$detailblendmode" "0"
    "$vertexalpha" "1"
    "$vertexcolor" "1"
    "$nocull" "1"
    "Proxies" {
        "TextureScroll"
		{
			"texturescrollvar" "$detailtexturetransform"
			"texturescrollrate" .5
			"texturescrollangle" -45
		}
    }
}