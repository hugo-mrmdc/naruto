UnlitGeneric {
    "$basetexture" "narutorp/effects/chinoike/common_gore"

	"$vertexalpha" "1"
	"$vertexcolor" "1"
    "$nocull" "1"
    "$size" "1"
    "$model" "1"

    "Proxies" {
        "Sine" {
            sineperiod 1.7
			sinemin 0.95
			sinemax 1.05
			timeoffset .2
			resultvar $size
        }
        "TextureTransform"
		{
			scalevar $size
			resultvar $basetexturetransform
		}
        "TextureScroll"
		{
			"texturescrollvar" "$basetexturetransform"
			"texturescrollrate" .25
			"texturescrollangle" 90
		}
    }
}