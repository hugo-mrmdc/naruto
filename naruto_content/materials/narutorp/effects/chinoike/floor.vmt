UnlitGeneric {
    "$basetexture" "narutorp/effects/shadow/shadowfloor"
    "$detail" "narutorp/effects/chinoike/vladimir_base_e_bloodball_stings"
    "$detailscale" "2"
    "$detailblendmode" "8"
    "$vertexalpha" "1"
    "$vertexcolor" "1"
    "$nocull" "1"
    "Proxies" {
        "TextureScroll"
		{
			"texturescrollvar" "$detailtexturetransform"
			"texturescrollrate" .25
			"texturescrollangle" 60
		}
    }
}