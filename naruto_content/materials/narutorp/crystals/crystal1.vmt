"VertexLitGeneric"
{
	$basetexture	"models\props_xen\crystal_purestsample"
	$bumpmap 	"models\props_xen\crystal_purestsample_nm"
	$model 		1
	$selfillum 		1

	$detail "narutorp/noise/waves"
	$detailscale 	3
	$detailblendmode 2
	$detailtint "[0 2 0]"

	"$envmap" 	"env_cubemap" 
   	"$envmaptint" 	"[4 1 4]"
	"$normalmapalphaenvmapmask" "1"
	
	"$lightwarptexture" "models\effects\lightwarp_atlas"
	"$WARPINDEX_DIFF" "1"
	"$WARPINDEX_SPEC" "1"

	$phong 	1
    $phongexponent 	5
    $phongboost 	5
    $phongtint 	"[0 255 0]"
    $halflambert 	1
	$phongfresnelranges "[1 0 1]"  //The angle of the dangle

	$rimlight 		"1"
	$rimlightexponent 	"50" //Range
	$rimlightboost 	"0.1"

	"Proxies" {
		"TextureScroll" {
			"texturescrollvar" "$basetexturetransform"
			"texturescrollrate" "0.5"
			"texturescrollangle" "90"
		}
		"TextureScroll" {
			"texturescrollvar" "$detailtexturetransform"
			"texturescrollrate" ".3"
			"texturescrollangle" "-90"
		}
	}
}