VertexLitGeneric
{
   "$basetexture" "narutorp\ashura\1059_weapon"
   "$bumpmap" "narutorp\shaders\phong"
    $lightwarptexture "narutorp\shaders\toon"

    $selfillum 1
    $selfillummask "narutorp\ashura\1059_weapon_light"

    $phong "1"
    $phongboost "1"
    $phongalbedoboost "35"
    $phongfresnelranges "[0.1 0.1 1]"
    $phongdisablehalflambert "1" // Disables diffuse lighting contribution in the phong model
    $phongalbedotint "1"

    $rimlight "1"
    $rimmask "1"
    $rimlightboost "1"
    $rimlightexponent "100"
	
    $nocull 1
    $halflambert 1
}
