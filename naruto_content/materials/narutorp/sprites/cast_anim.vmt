UnlitGeneric {
    "$basetexture" "narutorp/sprites/cast_anim"
    "$vertexalpha" "1"
    "$vertexcolor" "1"
    "Proxies" {
        "AnimatedTexture" {
            "animatedTextureVar" "$basetexture"
            "animatedTextureFrameNumVar" "$frame"
            "animatedTextureFrameRate" "24"
        }
    }
}