UnlitGeneric {
    "$basetexture" "narutorp/noise/waves"
    "$vertexcolor" 1
    "$vertexalpha" 1
    "$ignorez" 1
    "$additive" 1
    "$translucent" "1"
    "Proxies" {
        "TextureScroll" {
            "textureScrollVar" "$basetexturetransform"
            "scrollAngle" "0"
            "scrollRate" "0.1"
        }
    }
}