"UnlitGeneric"
{
    "$basetexture" "amry_feu_3"
    
    "$translucent" "1"              
    "$additive" "1"                 
    "$nocull" "1"   
    $vertexcolor 1
    $vertexalpha 1      
//76561199235045344
    "Proxies"
    {
        "AnimatedTexture"
        {
            "animatedTextureVar" "$baseTexture"
            "animatedTextureFrameNumVar" "$frame"
            "animatedTextureFrameRate" "30"
        }
    }
}