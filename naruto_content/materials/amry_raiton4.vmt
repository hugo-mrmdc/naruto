SpriteCard
{
$basetexture "amry_raiton4"
$vertexcolor 1
$vertexalpha 1
$translucent 1
//76561199235045344
    "Proxies"
    {
        "AnimatedTexture"
        {
            "animatedTextureVar" "$baseTexture"
            "animatedTextureFrameNumVar" "$frame"
            "animatedTextureFrameRate" "30"
        }
    }
}
