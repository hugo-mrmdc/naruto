"UnlitGeneric"
{
             "$basetexture" "Ya_frame"
               $additive 1
                 " $nocull" 1
                "$translucent" "1"
	"$vertexcolor" "1"
	"$vertexalpha" "1"
                 "$color" "[13 10 2]"
 "Proxies"
 {
  "AnimatedTexture"
  {
   "animatedTextureVar" "$basetexture"
   "animatedTextureFrameNumVar" "$frame"
   "animatedTextureFrameRate" "20"
  }
}