"VertexlitGeneric"
{
	"$basetexture" "gluk/squarejutsutextures/square1"
                "$lightwarptexture" "gluk/squarejutsutextures/lightwarpshader"
	"$nocull" 1
	"$translucent" 1
                "$additive" 0
	"$nodecal" 1

	"$detail" "gluk/squarejutsutextures/square1"	
	"$detailscale" 1
	"$detailblendfactor" .5
	"$detailblendmode" 3
	"$color2" "[1 1 1]"

	"$selfillum" "0"
	"$selfillumtint" "[255 255 255]"
	"$selfillumFresnel" 0
	"$selfillumFresnelMinMaxExp" "[0 0 0]"
                "$selfillummask" "gluk/squarejutsutextures/square1"

	"$phong" "0"
	"$phongexponent" 0
	"$phongboost" 0
	"$phongfresnelranges"	"[1 0 0]"
	"$basealphaenvmapmask" 0

	"$basemapalphaphongmask" 1

	"$rimlight" 1												
	"$rimlightexponent" 1
	"$rimlightboost" "-10"	

"Proxies"
	{
		"AnimatedTexture"
		{
			"animatedtexturevar" "$detail"
			"animatedtextureframenumvar" "$detailframe"
			"animatedtextureframerate" 24
		}
		"Sine"
		{
			"sinemin" ".2"
			"sinemax" ".6"
			"sineperiod" "1"
			"resultVar" "$selfillumtint[1]"
		}
		"Sine"
		{
			"sinemin" ".5"
			"sinemax" ".2"
			"sineperiod" "1.1"
			"resultVar" "$selfillumtint[0]"
		}
		"TextureScroll"
		{
			"texturescrollvar" "$detailtexturetransform"
			"texturescrollrate" 0.1
			"texturescrollangle" 50
		}
	


	}
}


