"UnlitGeneric"
{
	"$basetexture" "gluk/winddometextures/winddome"
	"$nocull" 0
	"$translucent" 1
                "$additive" 0
	"$nodecal"1
                "$alphatest" 0

//	"$detail" "gluk/winddometextures/winddome"	
//	"$detailscale" 1
//	"$detailblendfactor" 1
//	"$detailblendmode" 4
	

"Proxies"
	{
		"AnimatedTexture"
		{
			"animatedtexturevar" "$detail"
			"animatedtextureframenumvar" "$detailframe"
			"animatedtextureframerate" 24
		}
		"Sine"
		{
			"sinemin" ".2"
			"sinemax" ".6"
			"sineperiod" "1"
			"resultVar" "$selfillumtint[1]"
		}
		"Sine"
		{
			"sinemin" ".5"
			"sinemax" ".2"
			"sineperiod" "1.1"
			"resultVar" "$selfillumtint[0]"
		}
		"TextureScroll"
		{
			"texturescrollvar" "$basetexturetransform"
			"texturescrollrate" 1.5
			"texturescrollangle" -180
		}
	


	}

}


