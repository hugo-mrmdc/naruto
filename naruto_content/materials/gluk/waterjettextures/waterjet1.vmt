"VertexlitGeneric"
{
	"$basetexture" "gluk/waterjettextures/waterjet1"
                "$lightwarptexture" "gluk/waterjettextures/lightwarpshader"
	"$nocull" 1
	"$translucent" 0
                "$additive" 0
	"$nodecal" 1

	"$detail" "gluk/waterjettextures/waterjet1"	
	"$detailscale" 1
	"$detailblendfactor" 1
	"$detailblendmode" 0

	"$phong" "0"
	"$phongexponent" 1
	"$phongboost" 1
	"$phongfresnelranges"	"[0 0 0]"
	"$basealphaenvmapmask" 1
 
	"$basemapalphaphongmask" 1

	"$rimlight" 0												
	"$rimlightexponent" 1
	"$rimlightboost" "-100"	

"Proxies"
	{
		"AnimatedTexture"
		{
			"animatedtexturevar" "$detail"
			"animatedtextureframenumvar" "$detailframe"
			"animatedtextureframerate" 24
		}
		"Sine"
		{
			"sinemin" ".2"
			"sinemax" ".6"
			"sineperiod" "1"
			"resultVar" "$selfillumtint[1]"
		}
		"Sine"
		{
			"sinemin" ".5"
			"sinemax" ".2"
			"sineperiod" "1.1"
			"resultVar" "$selfillumtint[0]"
		}
		"TextureScroll"
		{
			"texturescrollvar" "$detailtexturetransform"
			"texturescrollrate" 2
			"texturescrollangle" -70
		}
	


	}

}


