"VertexlitGeneric"
{
	"$basetexture" "gluk/pyramidjutsutextures/pyramid2"
                "$lightwarptexture" "gluk/pyramidjutsutextures/lightwarpshader"
	"$nocull" 1
	"$translucent" 1
                "$additive" 1
	"$nodecal" 1

	"$detail" "gluk/pyramidjutsutextures/pyramid2"	
	"$detailscale" "3"
	"$detailblendfactor" -.5
	"$detailblendmode" 1
//	"$color2" "[0 0 0]"

	"$phong" "1"
	"$phongexponent" "1"
	"$phongboost" "1"	
	"$phongfresnelranges"	"[0 0 0]"
	"$basealphaenvmapmask" "1"

	"$selfillum" "0"
	"$selfillumtint" "[0 0 0]"
	"$selfIllumFresnel" 1
	"$selfIllumFresnelMinMaxExp" "[0 1 0]"

	"$rimlight" "0"												
	"$rimlightexponent" "1"
	"$rimlightboost" "-50"	

"Proxies"
	{
		"AnimatedTexture"
		{
			"animatedtexturevar" "$detail"
			"animatedtextureframenumvar" "$detailframe"
			"animatedtextureframerate" 24
		}
		"Sine"
		{
			"sinemin" ".2"
			"sinemax" ".6"
			"sineperiod" "1"
			"resultVar" "$selfillumtint[1]"
		}
		"Sine"
		{
			"sinemin" ".5"
			"sinemax" ".2"
			"sineperiod" "1.1"
			"resultVar" "$selfillumtint[0]"
		}
		"TextureScroll"
		{
			"texturescrollvar" "$detailtexturetransform"
			"texturescrollrate" 0.1
			"texturescrollangle" 0
		}
	


	}

}


