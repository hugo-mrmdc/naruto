"VertexlitGeneric"
{
	"$basetexture" "gluk/firetornadotextures/addative1"
                "$lightwarptexture" "gluk/firetornadotextures/lightwarpshader"
	"$nocull" 0
	"$translucent" 1
                "$additive" 1
	"$nodecal" 1
                "$alphatest" 0

	"$detail" "gluk/firetornadotextures/firetornado2"	
	"$detailscale" 2
	"$detailblendfactor" 1
	"$detailblendmode" 4

	"$phong" "1"
	"$phongexponent" 1
	"$phongboost" 1
	"$phongfresnelranges"	"[0 0 0]"
	"$basealphaenvmapmask" 0
 
	"$basemapalphaphongmask" 0

	"$rimlight" 0												
	"$rimlightexponent" 1
	"$rimlightboost" "-50"	

"Proxies"
	{
		"AnimatedTexture"
		{
			"animatedtexturevar" "$detail"
			"animatedtextureframenumvar" "$detailframe"
			"animatedtextureframerate" 24
		}
		"Sine"
		{
			"sinemin" ".2"
			"sinemax" ".6"
			"sineperiod" "1"
			"resultVar" "$selfillumtint[1]"
		}
		"Sine"
		{
			"sinemin" ".5"
			"sinemax" ".2"
			"sineperiod" "1.1"
			"resultVar" "$selfillumtint[0]"
		}
		"TextureScroll"
		{
			"texturescrollvar" "$detailtexturetransform"
			"texturescrollrate" 1.3
			"texturescrollangle" 90
		}
	


	}

}


