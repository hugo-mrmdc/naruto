UnlitGeneric{
    "$basetexture" "narutorp/effects/zap3"
    "$vertexalpha" "1"
    "$vertexcolor" "1"
    "Proxies" {
        "AnimatedTexture" {
            "animatedTextureVar" "$basetexture"
            "animatedTextureFrameNumVar" "$frame"
            "animatedTextureFrameRate" "15"
        }
    }
}