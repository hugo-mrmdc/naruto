UnlitGeneric
{
	$basetexture "yugen/models/naruto/effects/nr_aura1"

	$detail "yugen/models/naruto/effects/nr_aura1_a"
	$detailblendmode 1
	$detailscale 1
	$detailblendfactor 0.99

	$alpha 0.98
	$additive 1

	$vertexcolor 1
	$vertexalpha 1

	Proxies
	{
		TextureScroll
		{
			texturescrollvar "$detailtexturetransform"
			texturescrollrate 1
			texturescrollangle 90
		}
	}
}