"UnlitGeneric"
{
	"$basetexture" "effects/xen_teleporter_screen_red"
	"$additive" "1"
//	"$vertexalpha" "1"
//	"$vertexcolor" 1
	"%keywords" "bms"
	"Proxies"
	{
		"AnimatedTexture"
		{
			"animatedtexturevar" "$basetexture"
			"animatedtextureframenumvar" "$frame"
			"animatedtextureframerate" 30
		}
	}
}
