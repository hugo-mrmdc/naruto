"UnLitTwoTexture"
{
 "%tooltexture" "effects/dust_lightray"
 "$basetexture" "effects/dust_window_scroll"
 "$texture2" "effects/dust_lightray"
 //"$basetexturetransform" "center .5 .5 scale .1 .1 rotate 0 translate 0 0"
 //"$translucent" 1
 "$additive" "1"
 "$nodecal"	"1"
 "$nocull"	"1"
 //"$no_fullbright" 1
 //"$nofog" "1"
 
 "$scale" "[1 1]"
 "$scroll" "[3 3]"
 "Proxies"
 {
  "LinearRamp"
  {
   "resultVar" "$scroll[0]"
   "rate" -.025
  }
  "LinearRamp"
  {
   "resultVar" "$scroll[1]"
   "rate" -.05
  }
  "TextureTransform"
  {
   "scaleVar" "$scale"
   "translateVar" "$scroll"
   "resultVar" "$basetexturetransform"
  }
    "PlayerView"
	{
	"scale"	".5"
	"resultVar"	"$alpha"
	}
 
 }
}
