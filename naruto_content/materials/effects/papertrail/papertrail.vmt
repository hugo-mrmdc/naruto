"Spritecard"
{
    // Базовая текстура (будет игнорироваться)
    "$basetexture" "effects/papertrail/papertrail"  
    "$translucent" 1

    // --- Полное игнорирование текстуры ---
    "$ignoretexture" 1           // Важно: игнорирует саму текстуру (Source Engine)
    // или альтернатива:
    "$color" "[10 10 10]"        // Гипер-белый (значения >>1 для пересвета)
    "$ignoretexturealpha" 1      // Игнорировать альфа-канал
    "$noalphamodulation" 1       // Отключить влияние текстуры на прозрачность

    // --- Отключаем освещение и делаем ровный цвет ---
    "$selfillum" 1               // Самосвечение (цвет не зависит от света)
    "$selfillumtint" "[10 10 10]" // Цвет свечения = основной цвет
    "$overbrightfactor" 10       // Максимальная яркость

    // --- Отключаем ненужные эффекты ---
    "$vertexcolor" 0             // Запрещаем менять цвет через вертексы
    "$vertexalpha" 0             // Запрещаем менять прозрачность
}