"UnlitGeneric"
{
	"$basetexture" "effects/lensFlare/animatedflare_1"
//    "$translucent" "1"
//    "$vertexcolor" "1"
//   "$vertexalpha" "1"
//    "$ignorez"     "1"
    "$additive" 1

    "Proxies" 
    { 
    "MaterialModifyAnimated" 
        { 
        "animatedTextureVar" "$basetexture" 
        "animatedTextureFrameNumVar" "$frame" 
        "animatedTextureFrameRate" "30" 
        }
    }
}

