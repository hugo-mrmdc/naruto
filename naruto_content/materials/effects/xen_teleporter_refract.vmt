"Refract"
{
	"$model" 1
 	"$refractamount" ".025"
	"$bluramount" "0"
//	"$REFRACTTINT" "{100 100 100}"
	"$scale" "[1 1]"
 	"$normalmap" "effects/xen_teleporter_refract"
	"$nocull" 1
	"$envmap" "env_cubemap"
	"$envmaptint" "[.1 .1 .1]"
//	"$refracttinttexture" 	"models/water/WaterPlane2"


	"Proxies"
	{
		"AnimatedTexture"
		{
			"animatedtexturevar" "$normalmap"
			"animatedtextureframenumvar" "$bumpframe"
			"animatedtextureframerate" 30
		}
	}

}