
"UnlitGeneric"
{
             "$basetexture" "gow_fx/txr_lighting5"
               $additive 1
               $selfillum 1
               "$nocull" 1
               "$vertexcolor" "1"
                "$color" "[13 10 2]"
 "Proxies"
 {
  "AnimatedTexture"
  {
   "animatedTextureVar" "$basetexture"
   "animatedTextureFrameNumVar" "$frame"
   "animatedTextureFrameRate" "20"
  }
}