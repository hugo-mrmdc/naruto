
"UnlitGeneric"
{
             "$basetexture" "gow_fx/txr_lighting2"
               $additive 1
                 " $nocull" 1
                "$translucent" "1"
	"$vertexcolor" "1"
	"$vertexalpha" "1"
                 
 "Proxies"
 {
  "AnimatedTexture"
  {
   "animatedTextureVar" "$basetexture"
   "animatedTextureFrameNumVar" "$frame"
   "animatedTextureFrameRate" "20"
  }
}