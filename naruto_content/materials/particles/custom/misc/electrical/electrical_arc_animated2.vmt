"UnlitGeneric"
{
	$basetexture	"particles/custom/misc/electrical/electrical_arc_sprites4"
	$vertexcolor	1 
	$vertexalpha	1 
	$nolod			1
	$additive		1

	"Proxies"
	{
		"AnimatedTexture"
		{
			"animatedtexturevar" "$basetexture"
			"animatedtextureframenumvar" "$frame"
			"animatedtextureframerate" "30"
		}
	}
}