UnlitGeneric
{
	$basetexture faris/effects/vzriv
	$surfaceprop Default
	$translucent 1
	$vertexcolor 1
	$vertexalpha 1
	$additive 1
    $alpha 1
	Proxies
	{
	UniformNoise
		{
		minVal 0
		
		maxVal 28
        
		resultvar $frame
		}

		AnimatedTexture
		{
		animatedTextureVar $basetexture
		animatedTextureFrameNumVar $frame
		animatedTextureFrameRate 28
    
		}
	}

}
