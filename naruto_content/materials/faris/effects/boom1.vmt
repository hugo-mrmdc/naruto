UnlitGeneric
{
	$basetexture faris/effects/boom1
	$surfaceprop Default
	$translucent 1
	$vertexcolor 1
	$vertexalpha 1
	$additive 1
    $alpha 1
	Proxies
	{
	UniformNoise
		{
		minVal 0
		
		maxVal 63
        
		resultvar $frame
		}

		AnimatedTexture
		{
		animatedTextureVar $basetexture
		animatedTextureFrameNumVar $frame
		animatedTextureFrameRate 63
    
		}
	}

}
