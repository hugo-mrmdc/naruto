UnlitGeneric
{
	$basetexture faris/effects/slashes
	$surfaceprop Default
	$translucent 1
	$vertexcolor 1
	$vertexalpha 1
	$additive 1
    $alpha 1
	Proxies
	{
	UniformNoise
		{
		minVal 1
		maxVal 18
        
		resultvar $frame
		}

		AnimatedTexture
		{
		animatedTextureVar $basetexture
		animatedTextureFrameNumVar $frame
		animatedTextureFrameRate 18
    
		}
	}

}
