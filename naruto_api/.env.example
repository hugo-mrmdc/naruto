# Copie ce fichier en ".env" et remplis tes vraies valeurs.
# Ne commit JAMAIS le fichier ".env" (il est dans .gitignore).

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=naruto_api
DB_USER=naruto_api
DB_PASS=change_me

# Clé secrète partagée avec le serveur GMod (envoyée dans le header X-Api-Key).
# Génère une longue chaîne aléatoire, par ex : php -r "echo bin2hex(random_bytes(32));"
API_KEY=change_me_avec_une_longue_cle_aleatoire

# Décalage horaire pour les dates stockées/affichées
APP_TIMEZONE=Europe/Paris
