# Copie ce fichier en ".env" et remplis tes vraies valeurs.
# Ne commit JAMAIS le fichier ".env" (il est dans .gitignore).

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=naruto_api
DB_USER=naruto_api
DB_PASS=change_me

# Clé secrète partagée avec le serveur GMod (envoyée dans le header X-Api-Key).
# Génère une longue chaîne aléatoire, par ex : php -r "echo bin2hex(random_bytes(32));"
API_KEY=change_me_avec_une_longue_cle_aleatoire

# Décalage horaire pour les dates stockées/affichées
APP_TIMEZONE=Europe/Paris

# Mot de passe du dashboard (public/dashboard/), PAS en clair : mets ici le
# HASH généré par la commande ci-dessous (remplace "ton_mot_de_passe") :
#   php -r "echo password_hash('ton_mot_de_passe', PASSWORD_DEFAULT);"
# Tant que cette valeur est absente ou laissée telle quelle, le dashboard
# refuse tout le monde (aucun accès possible par erreur de config).
DASHBOARD_PASSWORD_HASH=colle_ici_le_hash_genere
