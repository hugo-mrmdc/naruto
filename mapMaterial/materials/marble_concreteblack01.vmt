"LightmappedGeneric"
{
	$basetexture               "perso/spy/pbr/floormarble03_basecolor"
	$bumpmap                   "perso/spy/pbr/floormarble03_bump"

    $color                     "[ .1 .1 .1 ]"

	$envmap                    "env_cubemap"
	$normalmapalphaenvmapmask  1

	$envmaptint                "[ .1 .1 .1 ]"
}