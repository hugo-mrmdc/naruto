"Water"
{

	<dx90
	{
		 	"$fallbackmaterial" "water/water_2fort_dx80"
	}

	"%keywords" "tf liquidpack"
	"%compilewater" 1
	"%tooltexture" "liquidpack/water/water_slime"
	"$abovewater" 1

	"$envmap" "env_cubemap"

	"$refracttexture" "_rt_WaterRefraction"
	"$refractamount" ".5"
	"$refracttint" "{255 158 240}"

	"$reflecttexture" "_rt_WaterReflection"
	"$reflectamount" "0.2"
	"$reflecttint" "{255 158 240}"

	"$scale" "[1 1]"

	"$normalmap" "liquidpack/water/water_slime"
	"$surfaceprop" "water"
	"$bottommaterial" "liquidpack/water/unique/water_slime_purple_beneath"
	"$bumpframe" "0"

	"$fogenable" 1
	"$fogcolor" "{64 45 92}"
	"$fogstart" "0"
	"$fogend" "100"

	"Water_DX60"
	{
		"$fallbackmaterial" "nature/water_dx70"
	}

	"Proxies"
	{
		"AnimatedTexture"
		{
			"animatedtexturevar" "$normalmap"
			"animatedtextureframenumvar" "$bumpframe"
			"animatedtextureframerate" 24.00
		}
		"TextureScroll"
		{
			"texturescrollvar" "$bumptransform"
			"texturescrollrate" .03
			"texturescrollangle" 15
		}
		"WaterLOD"
		{
			 fixme!  This has to be here, or material loading barfs.
			"dummy" 0
		}
	}
}