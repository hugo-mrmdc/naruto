"VertexlitGeneric"
{
	"$basetexture" "gluk/incubatortextures/transparent"
	"$nocull" 1
	"$translucent" 1
                "$additive" 1
	"$nodecal" 1

	"$detail" "gluk/incubatortextures/bubble2"	
	"$detailscale" 1
	"$detailblendfactor" 1
	"$detailblendmode" 0
//	"$color2" "[1 1 1]"

	"$phong" "1"
	"$phongexponent" 1
	"$phongboost" 1
	"$phongfresnelranges"	"[0 0 0]"
	"$basealphaenvmapmask" 1
 
	"$basemapalphaphongmask" 1	

"Proxies"
	{
		"AnimatedTexture"
		{
			"animatedtexturevar" "$detail"
			"animatedtextureframenumvar" "$detailframe"
			"animatedtextureframerate" 24
		}
		"Sine"
		{
			"sinemin" ".2"
			"sinemax" ".6"
			"sineperiod" "1"
			"resultVar" "$selfillumtint[1]"
		}
		"Sine"
		{
			"sinemin" ".5"
			"sinemax" ".2"
			"sineperiod" "1.1"
			"resultVar" "$selfillumtint[0]"
		}
		"TextureScroll"
		{
			"texturescrollvar" "$detailtexturetransform"
			"texturescrollrate" 0.2
			"texturescrollangle" 90
		}
	


	}

}
