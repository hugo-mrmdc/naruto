"VertexlitGeneric"
{
	"$basetexture" "gluk/incubatortextures/incubator2"
	"$nocull" 1
	"$translucent" 1
                "$additive" 1
	"$nodecal" 1

	"$detail" "gluk/incubatortextures/water"	
	"$detailscale" 1
	"$detailblendfactor" -1
	"$detailblendmode" 1
//	"$color2" "[1 1 1]"

	"$selfillum" "0"
	"$selfillumtint" "[255 255 255]"
	"$selfillumFresnel" 0
	"$selfillumFresnelMinMaxExp" "[0 0 0]"
                "$selfillummask" "gluk/incubatortextures/incubator2"

	"$phong" "1"
	"$phongexponent" 1
	"$phongboost" 1
	"$phongfresnelranges"	"[5 1 20]"
	"$basealphaenvmapmask" 1
 
	"$basemapalphaphongmask" 1

	"$rimlight" 0												
	"$rimlightexponent" 1
	"$rimlightboost" "-100"	

"Proxies"
	{
		"AnimatedTexture"
		{
			"animatedtexturevar" "$detail"
			"animatedtextureframenumvar" "$detailframe"
			"animatedtextureframerate" 24
		}
		"Sine"
		{
			"sinemin" ".2"
			"sinemax" ".6"
			"sineperiod" "1"
			"resultVar" "$selfillumtint[1]"
		}
		"Sine"
		{
			"sinemin" ".5"
			"sinemax" ".2"
			"sineperiod" "1.1"
			"resultVar" "$selfillumtint[0]"
		}
		"TextureScroll"
		{
			"texturescrollvar" "$detailtexturetransform"
			"texturescrollrate" 0.1
			"texturescrollangle" 90
		}
	


	}

}


