"VertexlitGeneric"
{
	"$basetexture" "models/physics_props/ir_hookahbar_barstool_dm"
	"$bumpmap" "models/physics_props/ir_hookahbar_barstool_nm"
	$envmap env_cubemap
	$normalmapalphaenvmapmask 1
	$envmaptint "[.2 .2 .2]"
	

	"$phong" 					"1"
	"$phongtint" 			"[.6 .8 1]"
	//"$phongtint" 			"[1 .8 .6]"
	"$phongexponent"			"25"
	"$phongboost" 				"1"	
	"$phongfresnelranges"		"[1 5 3]"
 }
