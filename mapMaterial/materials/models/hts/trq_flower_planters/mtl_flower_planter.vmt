VertexLitGeneric
{
	$basetexture "models/hts/trq_flower_planters/mtl_flower_planter_images"
	$bumpmap "models/hts/trq_flower_planters/mtl_flower_planter_images_n"

	$alphatest 1
	$nocull 1

	$envmap "env_cubemap"
	$normalmapalphaenvmapmask 1

	$phong 1
	$phongfresnelranges "[1 1 1]"
	$phongexponent 97
	$phongboost 8
	$phongalbedoboost 8

	$allowalphatocoverage 1
}