lightmappedgeneric
{
$basetexture "tile/countertop05"

	"$bumpmap" "maps\bm_damocles\damo_concrete_floor00_normal"
	// "$surfaceprop" "concretegrit" // ancienne valeur, la valeur effective reste tile

        "$detail" "detail\plaster_detail_01"
	"$detailscale" "8"
	"$detailblendfactor" "0.45"
	"$detailblendmode" "0"

	"$envmap" "env_cubemap"
   	"$envmaptint" "[.3 .3 .3]"
	"$envmapcontrast" 2
	"$normalmapalphaenvmapmask" 1

$surfaceprop tile
}

