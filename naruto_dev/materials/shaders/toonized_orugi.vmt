screenspace_general
{
    $pixshader "toonized_orugi_ps20"

    $basetexture "_rt_FullFrameFB"
    $texture1    ""
    $texture2    ""
    $texture3    ""

    $x360appchooser 1
    $ignorez        1
    $fix_fb         32768
    "<dx90"
    {
        $no_draw 1
    }
        
    $copyalpha                 1
    $alpha_blend_color_overlay 0
    $alpha_blend               0
    $linearwrite               0
    $linearread_basetexture    0
    $linearread_texture1       0
    $linearread_texture2       0
    $linearread_texture3       0

    // Constants0 (c0)
    $c0_x     3.0   // ToonLevels
    $c0_y     0.35  // ShadowStrength
    $c0_z     0.18  // EdgeThreshold
    $c0_w     1.4   // EdgeWidth

    // Constants1 (c1)
    $c1_x     1.45  // SaturationBoost
    $c1_y     1.1   // BrightnessBoost
    $c1_z     1.35  // ContrastBoost
    $c1_w     3.5   // RimStrength

    Proxies
    {
        Equals
        {
            srcVar1         $fix_fb
            resultVar       $flags2
        }
    }
}
