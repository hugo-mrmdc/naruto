"VertexlitGeneric"
{
	"$basetexture" "gluk/fireballtextures/fire"
                "$lightwarptexture" "gluk/fireballtextures/lightwarpshader"
	"$nocull" 1
	"$translucent" 1
                "$additive" 0
	"$nodecal" 1
                "$alphatest" 1
                "$selfillum" 0

	"$phong" "1"
	"$phongexponent" 1
	"$phongboost" 1
	"$phongfresnelranges"	"[0 0 0]"




"Proxies"
	{
		"AnimatedTexture"
		{
			"animatedtexturevar" "$basetexture"
			"animatedtextureframenumvar" "$frame"
			"animatedtextureframerate" 20
		}
		"TextureScroll"
		{
			"texturescrollvar" "$basetexturetransform"
			"texturescrollrate" 0
			"texturescrollangle" 0
		}
	


	}

}

