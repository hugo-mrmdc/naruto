"VertexlitGeneric"
{
	"$basetexture" "gluk/waterprisontextures/transparent"
                "$lightwarptexture" "gluk/waterprisontextures/lightwarpshader"
	"$nocull" 0
	"$translucent" 1
                "$additive" 0
	"$nodecal" 1

	"$detail" "gluk/waterprisontextures/water3"	
	"$detailscale" 1
	"$detailblendfactor" 1
	"$detailblendmode" 4
//	"$color2" "[1 2 255]"

	"$phong" "0"
	"$phongexponent" 1
	"$phongboost" 1
	"$phongfresnelranges"	"[1 0 10]"
	"$basealphaenvmapmask" 0

	"$basemapalphaphongmask" 1

	"$rimlight" 0												
	"$rimlightexponent" 1
	"$rimlightboost" "-100"	

"Proxies"
	{
		"AnimatedTexture"
		{
			"animatedtexturevar" "$detail"
			"animatedtextureframenumvar" "$detailframe"
			"animatedtextureframerate" 24
		}
		"Sine"
		{
			"sinemin" ".2"
			"sinemax" ".6"
			"sineperiod" "1"
			"resultVar" "$selfillumtint[1]"
		}
		"Sine"
		{
			"sinemin" ".5"
			"sinemax" ".2"
			"sineperiod" "1.1"
			"resultVar" "$selfillumtint[0]"
		}
		"TextureScroll"
		{
			"texturescrollvar" "$detailtexturetransform"
			"texturescrollrate" 0.1
			"texturescrollangle" 50
		}
	


	}

}


