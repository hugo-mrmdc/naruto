"VertexlitGeneric"
{
	"$basetexture" "gluk/waterprisontextures/water2"
                "$lightwarptexture" "gluk/waterprisontextures/lightwarpshader"
	"$nocull" 1
	"$translucent" 1
                "$additive" 0
	"$nodecal" 1

	"$detail" "gluk/waterprisontextures/water5"	
	"$detailscale" 1
	"$detailblendfactor" .5
	"$detailblendmode" 4
	"$color2" "[1 1 20]"

	"$selfillum" "0"
	"$selfillumtint" "[255 255 255]"
	"$selfillumFresnel" 0
	"$selfillumFresnelMinMaxExp" "[0 0 0]"
                "$selfillummask" "gluk/waterprisontextures/water2"

	"$phong" "0"
	"$phongexponent" 1
	"$phongboost" 1
	"$phongfresnelranges"	"[1 0 10]"
	"$basealphaenvmapmask" 0
 
	"$basemapalphaphongmask" 1

"Proxies"
	{
		"AnimatedTexture"
		{
			"animatedtexturevar" "$detail"
			"animatedtextureframenumvar" "$detailframe"
			"animatedtextureframerate" 24
		}
		"Sine"
		{
			"sinemin" ".2"
			"sinemax" ".6"
			"sineperiod" "1"
			"resultVar" "$selfillumtint[1]"
		}
		"Sine"
		{
			"sinemin" ".5"
			"sinemax" ".2"
			"sineperiod" "1.1"
			"resultVar" "$selfillumtint[0]"
		}
		"TextureScroll"
		{
			"texturescrollvar" "$detailtexturetransform"
			"texturescrollrate" 0.06
			"texturescrollangle" 120
		}
	


	}

}


