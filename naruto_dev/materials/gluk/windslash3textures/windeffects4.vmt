"UnlitGeneric"
{
	"$basetexture" "gluk/windslash3textures/addative2"
                "$lightwarptexture" "gluk/windslash3textures/lightwarpshader"
	"$nocull" 0
	"$translucent" 1
                "$additive" 1
	"$nodecal" 1
                "$alphatest" 0

	"$detail" "gluk/windslash3textures/windeffects4"	
	"$detailscale" 1
	"$detailblendfactor" 1
	"$detailblendmode" 4

	"$phong" "1"
	"$phongexponent" 1
	"$phongboost" 1
	"$phongfresnelranges"	"[0 0 0]"
	"$basealphaenvmapmask" 0
 
	"$basemapalphaphongmask" 0

	"$rimlight" 0												
	"$rimlightexponent" 1
	"$rimlightboost" "-50"	

"Proxies"
	{
		"AnimatedTexture"
		{
			"animatedtexturevar" "$detail"
			"animatedtextureframenumvar" "$detailframe"
			"animatedtextureframerate" 24
		}
		"TextureScroll"
		{
			"texturescrollvar" "$detailtexturetransform"
			"texturescrollrate" 2
			"texturescrollangle" -90
		}
	


	}

}


