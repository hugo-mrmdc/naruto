"VertexlitGeneric"
{
	"$basetexture" "atg/pvp/katon/atg_meteore/lightwarpshader2"
        "$lightwarptexture" "atg/pvp/sabaku/bouclier/lightwarpshader"
	"$nocull" 1
	"$translucent" 1
        "$additive" 1
	"$nodecal" 1
        "$alphatest" 0
	"$phong" "0"
	"$phongexponent" 1
	"$phongboost" 1
	"$phongfresnelranges"	"[0 0 0]"
	"$basealphaenvmapmask" 0
	"$basemapalphaphongmask" 0
	"$rimlight" 0												
	"$rimlightexponent" 1
	"$rimlightboost" "-50"	
	"$detail" "atg/pvp/katon/atg_meteore/atg_wind1"	
	"$detailscale" 1
	"$detailblendfactor" 1
	"$detailblendmode" 4

"Proxies"
	{
		"AnimatedTexture"
		{
			"animatedtexturevar" "$detail"
			"animatedtextureframenumvar" "$detailframe"
			"animatedtextureframerate" 24
		}
		"Sine"
		{
			"sinemin" ".2"
			"sinemax" ".6"
			"sineperiod" "1"
			"resultVar" "$selfillumtint[1]"
		}
		"Sine"
		{
			"sinemin" ".5"
			"sinemax" ".2"
			"sineperiod" "1.1"
			"resultVar" "$selfillumtint[0]"
		}
		"TextureScroll"
		{
			"texturescrollvar" "$detailtexturetransform"
			"texturescrollrate" 1
			"texturescrollangle" 90
		}
	


	}

}
